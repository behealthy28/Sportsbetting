{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "app.py" },
    { "src": "/pipeline", "dest": "/static/pipeline.html" },
    { "src": "/app", "dest": "/static/index.html" },
    { "src": "/", "dest": "/static/pipeline.html" }
  ]
}
